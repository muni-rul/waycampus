# ==============================================================================
# WayCampus Environment Configuration Template
# NOTE: Do NOT commit actual secrets or production values to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION: Cryptographic secret for signing JWT session tokens.
# Must be at least 16 characters long. In production, server fails closed if unset.
JWT_SECRET=

# Optional: Comma-separated list of allowed CORS origins.
# In development, http://localhost:5173 and http://localhost:3000 are permitted automatically.
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# ADMIN MODE CONFIGURATION (DISABLED BY DEFAULT IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production, admin features and all admin routes are completely DISABLED (return 404)
# unless BOTH ADMIN_PASSWORD and ADMIN_EMERGENCY_PIN are explicitly set (min 16 chars).
ADMIN_PASSWORD=
ADMIN_EMERGENCY_PIN=

# Optional: Metadata for the primary administrator account (used only when admin is enabled)
ADMIN_USERNAME=admin
ADMIN_NAME=Christ College Administrator
ADMIN_EMAIL=admin@christcollegeijk.edu.in

# ------------------------------------------------------------------------------
# CLOUD DATA PERSISTENCE & REPOSITORY SEPARATION
# ------------------------------------------------------------------------------
# To persist data on platforms with ephemeral disks (e.g. Render Free tier),
# configure a SEPARATE private repository for live data storage.
# The server will refuse to sync if GITHUB_DATA_REPO matches the application code repo.
GITHUB_TOKEN=
GITHUB_DATA_REPO=
GITHUB_DATA_BRANCH=main
GITHUB_DATA_PATH=server/data/campusnav_db.json

# Optional: Custom local directory path for persistent disk mounts (e.g. /var/data)
DATA_DIR=
